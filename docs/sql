CREATE DATABASE Popov1DB;
USE Popov1DB;
GO

--cоздание таблиц 
CREATE TABLE Readers (
    ReaderID INT PRIMARY KEY IDENTITY(1,1),
    FullName TEXT NOT NULL,
    Address TEXT,
    Phone TEXT
);

CREATE TABLE Books (
    BookID INT PRIMARY KEY IDENTITY(1,1),
    Title TEXT NOT NULL,
    Author TEXT NOT NULL,
    YearPublished INT,
    Genre TEXT,
    QuantityAvailable INT DEFAULT 1
);

CREATE TABLE Issues (
    IssueID INT PRIMARY KEY IDENTITY(1,1),
    ReaderID INT NOT NULL,
    BookID INT NOT NULL,
    IssueDate DATE DEFAULT GETDATE(),
    ReturnDate DATE NULL,
    CONSTRAINT FK_Issues_Reader FOREIGN KEY (ReaderID) REFERENCES Readers(ReaderID),
    CONSTRAINT FK_Issues_Book FOREIGN KEY (BookID) REFERENCES Books(BookID)
);
