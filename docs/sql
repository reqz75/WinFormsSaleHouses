--запросы
--какие книги сейчас на руках у читателей
SELECT r.FullName, b.Title, i.IssueDate
FROM Issues i
JOIN Readers r ON i.ReaderID = r.ReaderID
JOIN Books b ON i.BookID = b.BookID
WHERE i.ReturnDate IS NULL
ORDER BY i.IssueDate DESC;

--все книги Льва Толстого и кто их брал
SELECT b.Title, r.FullName, i.IssueDate, i.ReturnDate
FROM Books b
LEFT JOIN Issues i ON b.BookID = i.BookID
LEFT JOIN Readers r ON i.ReaderID = r.ReaderID
WHERE b.Author = 'Лев Толстой'
ORDER BY b.Title;

--топ-5 самых читаемых книг
SELECT TOP 5 b.Title, b.Author, COUNT(i.IssueID) AS Количество_выдач
FROM Books b
LEFT JOIN Issues i ON b.BookID = i.BookID
GROUP BY b.BookID, b.Title, b.Author
ORDER BY Количество_выдач DESC;

--читатели, у которых сейчас больше одной книги
SELECT r.FullName, COUNT(*) AS Книг_на_руках
FROM Issues i
JOIN Readers r ON i.ReaderID = r.ReaderID
WHERE i.ReturnDate IS NULL
GROUP BY r.ReaderID, r.FullName
HAVING COUNT(*) > 1;

--книги жанра «Роман», вышедшие после 1900 года
SELECT Title, Author, YearPublished
FROM Books
WHERE Genre = 'Роман' AND YearPublished > 1900
ORDER BY YearPublished DESC;
